# This file documents supported environment variables. Argus does not load it
# automatically. Set values in the PowerShell session that starts the service.

# Paths and runtime
ARGUS_STOCK_COMPARE_VENV=C:\venvs\argus-stock-comparison
ARGUS_DATA_LAKE=C:\ArgusData\data_lake
ARGUS_TDX_HOME=C:\new_tdx64
ARGUS_QMT_HOME=
ARGUS_FUTU_PORT=11111
ARGUS_PIP_INDEX_URL=https://pypi.org/simple

# Market refresh
ARGUS_MARKET_PROVIDER=tdx
ARGUS_MARKET_SYMBOLS=000001.SH,512400,562500,600519
ARGUS_LIVE_REFRESH_ENABLED=1
ARGUS_LIVE_SYMBOL_LIMIT=100
ARGUS_MARKET_POLL_SECONDS=10
ARGUS_MINUTE_REFRESH_SECONDS=60
ARGUS_DAILY_REFRESH_SECONDS=21600
ARGUS_HISTORY_REFRESH_SECONDS=86400

# Background research
ARGUS_REPORT_REFRESH_ENABLED=1
ARGUS_REPORT_POLL_SECONDS=3600
ARGUS_REPORT_DAILY_POLL_SECONDS=3600
ARGUS_REPORT_MAX_EQUITIES=8
ARGUS_REPORT_BULK_DELAY_SECONDS=0.25
ARGUS_DAILY_SOCIAL_SYMBOLS=3
ARGUS_HARNESS_AUTONOMY_ENABLED=1
ARGUS_HARNESS_POLL_SECONDS=86400
ARGUS_HARNESS_STARTUP_DELAY_SECONDS=20
ARGUS_HARNESS_STOCK_LIMIT=20
ARGUS_HARNESS_RUN_LEASE_MINUTES=240
ARGUS_CONTINUOUS_LEARNING_ENABLED=1
ARGUS_CONTINUOUS_LEARNING_POLL_SECONDS=60
ARGUS_CONTINUOUS_LEARNING_STARTUP_DELAY_SECONDS=30
ARGUS_CONTINUOUS_LEARNING_STOCK_LIMIT=20
ARGUS_POST_CLOSE_RETRY_MINUTES=30
ARGUS_QUANT_RUN_LEASE_MINUTES=240
ARGUS_SECTOR_CACHE_ENABLED=1
ARGUS_SECTOR_CACHE_POLL_SECONDS=3600
ARGUS_SECTOR_CACHE_STARTUP_DELAY_SECONDS=5
ARGUS_SECTOR_CACHE_MARKET_BATCH=12
ARGUS_SECTOR_CACHE_FUNDAMENTAL_BATCH=3

# Local Qwen models
ARGUS_QWEN3_MODEL_PATH=C:\ArgusModels\Qwen3-0.6B
ARGUS_QWEN3_MODEL_SHA256=
ARGUS_QWEN3_DEVICE=auto
ARGUS_QWEN3_BATCH_SIZE=128

# Optional public-information connectors. Never commit real values.
ARGUS_BILIBILI_BROWSER=chrome
ARGUS_X_BEARER_TOKEN=
ARGUS_SEC_IDENTITY=ArgusResearch your-email@example.com

# Email. Sending remains disabled unless ARGUS_EMAIL_SEND_ENABLED=1.
ARGUS_SMTP_HOST=smtp.example.com
ARGUS_SMTP_PORT=465
ARGUS_SMTP_USER=research@example.com
ARGUS_SMTP_PASSWORD=
ARGUS_ALERT_TO=research@example.com
ARGUS_EMAIL_SEND_ENABLED=0

# HTTP service and remote access
ARGUS_BIND_ADDRESS=127.0.0.1
ARGUS_PUBLIC_HOST=127.0.0.1
ARGUS_REMOTE_TOKEN_FILE=C:\ArgusSecrets\remote.token
ARGUS_ALLOWED_HOSTS=127.0.0.1,localhost
ARGUS_ALLOWED_ORIGINS=http://127.0.0.1:8765
ARGUS_API_RATE_LIMIT_PER_MINUTE=180
ARGUS_MAX_CONCURRENT_COMPARISONS=8
